|termlang=jam
|title=The Fear Factor: an Analysis of Crime in Jamaica and the Search for Solutions
|url=https://books.google.de/books?id=UwVzQpokW-UC&pg=PA12&dq=jamaica+garrison&hl=en&sa=X&ved=2ahUKEwjrg7qJkMntAhXOzoUKHarsDMoQ6AEwAnoECAMQAg#v=onepage&q=jamaica%20garrison&f=false
|year=2005
}}

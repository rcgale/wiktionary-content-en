#* {{quote-book
  | year = 1907
  | title = La Faraono
  | author = Kazimierz Bein (tr.)
  | by = Bolesław Prus
  | section = Introduction
  | passage = Sed multaj faraonoj '''regis''' mallonge.
  | translation = But many pharaohs ruled for a short time.
}}


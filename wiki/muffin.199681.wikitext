#* {{quote-book|en|author=Carrie Ewin|author2=Chris Ewin|author3=Cheryl Ewin|chapter=Lesson 5: Creating Text Posts|title=Facebook for Seniors: Connect with Friends and Family in 12 Easy Lessons|location=San Francisco, Caif.|publisher={{w|No Starch Press}}|year=2017|section=section “Viewing Your Posts on Your Timeline”|page=97|isbn=1-59327-791-1|passage=Hehe, I've eaten three apple muffins this morning. I've all '''muffined''' out!}}
# To feed muffins.
